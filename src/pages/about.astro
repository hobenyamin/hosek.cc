---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Reveal from '../components/Reveal.astro';
import AboutIntro from '../components/AboutIntro.astro';
import { ArrowDownRight, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import pfp from '../assets/pfp.jpg';
import { CONTACT } from '../consts';
---

<BaseLayout title="About" description="About Nikolas Hošek, a designer and frontend developer in Olomouc, Czechia — background, approach and contact.">

    <section id="about" class="relative z-10 px-4 md:px-6">

        {/* One screen on desktop; a normal scrolling column on phones. */}
        <div class="pt-24 pb-24 md:h-dvh md:pt-30 md:pb-30">

            <div class="flex flex-col gap-14 md:grid md:h-full md:grid-cols-3 md:grid-rows-[auto_1fr] md:gap-x-10 md:gap-y-25">
                <div>
                    <div class="@container flex gap-10">
                        <div>
                            <Masthead class="text-7xl sm:text-8xl md:text-7xl lg:text-8xl xl:text-9xl leading-none">About</Masthead>
                        </div>
                        <div class="flex items-end">
                            <ArrowDownRight class="size-11 stroke-2 masthead__arrow"/>
                        </div>
                    </div>
                </div>

                {/* One row on phones; `md:contents` makes it two grid cells on desktop. */}
                <div class="flex justify-between gap-6 md:contents">
                    <div class="flex items-end">
                    {/* Coordinates hide on small screens. */}
                    <span class="text-ink-50 text-[10px] font-semibold uppercase font-mono tracking-widest md:text-xs"><Reveal><span class="text-ink">Olomouc, CZ</span><span class="hidden sm:inline"> &mdash; 49.59&deg;N 17.25&deg;E</span></Reveal></span>
                </div>
                <div class="flex flex-col justify-end">
                    <Reveal class="text-[10px] font-semibold uppercase font-mono tracking-widest md:text-xs">Portfolio</Reveal>
                    <Reveal class="text-ink-50 text-[10px] font-semibold uppercase font-mono tracking-widest md:text-xs">Nikolas Hošek</Reveal>
                    <Reveal class="text-ink-50 text-[10px] font-semibold uppercase font-mono tracking-widest md:text-xs">Index &mdash; <span class="text-ink">01 / 04</span></Reveal>
                </div>
                </div>

                <div class="flex flex-col justify-between gap-14 md:gap-0">
                    {/* Full width on phones. */}
                    <div class="flex items-end gap-px" aria-hidden="true" data-about-swatch>
                        <div class="h-10 flex-1 bg-ink-20 md:h-20 md:w-8 md:flex-none"></div>
                        <div class="h-10 flex-1 bg-ink-50 md:h-20 md:w-8 md:flex-none"></div>
                        <div class="h-10 flex-1 bg-ink-70 md:h-20 md:w-8 md:flex-none"></div>
                        <div class="h-10 flex-1 bg-ink md:h-20 md:w-8 md:flex-none"></div>
                        <div class="h-10 flex-1 bg-signal md:h-20 md:w-8 md:flex-none"></div>
                    </div>
                    <div class="flex flex-col gap-5 " data-about>
                        <div class="flex flex-col">
                            <div>
                                <span class="text-[10px] uppercase font-black text-signal">00-1/</span>
                            </div>
                            <div class="flex justify-between items-end">
                                <div class="flex items-center gap-2 -ml-0.8">
                                    <X size={8} stroke-width={4} class="text-ink-50"/>
                                    <span class="text-sm font-medium text-ink-50 underline">Approach</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-col gap-3 max-w-md">
                            <span class="text-ink text-xl font-semibold leading-none tracking-wide">Design and build are the same job. I design the interface, then code it so nothing gets lost between the two.</span>
                            <div class="flex flex-col">
                                <span class="text-ink-50 italic text-xs font-semibold uppercase font-mono tracking-widest">Frontend Development</span>
                                <span class="text-ink-50 italic text-xs font-semibold uppercase font-mono tracking-widest">UI/UX Design</span>
                                <span class="text-ink-50 italic text-xs font-semibold uppercase font-mono tracking-widest">Freelance Web Projects</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col gap-15">
                    <div class="flex flex-col gap-4" data-about>
                        <div class="flex flex-col">
                            <div>
                                <span class="text-[10px] uppercase font-black text-signal">00-2/</span>
                            </div>
                            <div class="flex justify-between items-end">
                                <div class="flex items-center gap-2 -ml-0.8">
                                    <X size={8} stroke-width={4} class="text-ink-50"/>
                                    <span class="text-sm font-medium text-ink-50 underline">Biography</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-col gap-3 max-w-md">
                            <span class="text-ink text-xl font-semibold leading-none tracking-wide">I'm a 22-year-old designer and developer based in Olomouc. I design interfaces and then build them with intent.</span>
                            <span class="text-ink-50 italic text-xs font-semibold uppercase font-mono tracking-widest">Away from the screen I'm a classically trained pianist, which is probably where the sense of precision comes from. Otherwise out bouldering, hiking, over a chessboard, or somewhere new looking for good food.</span>
                            <span class="text-ink text-xl font-semibold leading-none tracking-wide">I'm open to frontend roles and taking on freelance projects from September 2026.</span>
                        </div>
                    </div>
                </div>
                <div class="flex flex-col gap-15">

                    <div class="flex flex-col gap-5" data-about>
                        <div class="flex flex-col">
                            <div>
                                <span class="text-[10px] uppercase font-black text-signal">00-3/</span>
                            </div>
                            <div class="flex justify-between items-end">
                                <div class="flex items-center gap-2 -ml-0.8">
                                    <X size={8} stroke-width={4} class="text-ink-50" />
                                    <span class="text-sm font-medium text-ink-50 underline">Contact</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-col gap-1">
                            {/* Click copies (no mail app). Only the label rolls, the brackets stay. */}
                            <button type="button" data-copy={CONTACT.email} data-cursor="Copy" data-cursor-done="Copied" aria-label={`Copy email address ${CONTACT.email}`} class="w-fit text-ink-50 text-xs font-semibold uppercase font-mono tracking-widest hover:text-ink transition-all"><span class="text-ink">[</span> <Reveal swap>{CONTACT.email}</Reveal> <span class="text-ink">]</span></button>

                            <button type="button" data-copy={CONTACT.phoneRaw} data-cursor="Copy" data-cursor-done="Copied" aria-label={`Copy phone number ${CONTACT.phone}`} class="w-fit text-ink-50 text-xs font-semibold uppercase font-mono tracking-widest hover:text-ink transition-all"><span class="text-ink">[</span> <Reveal swap>{CONTACT.phone}</Reveal> <span class="text-ink">]</span></button>
                        </div>
                    </div>
                    <div class="flex flex-col gap-5" data-about>
                        <div class="flex flex-col">
                            <div>
                                <span class="text-[10px] uppercase font-black text-signal">00-4/</span>
                            </div>
                            <div class="flex justify-between items-end">
                                <div class="flex items-center gap-2 -ml-0.8">
                                    <X size={8} stroke-width={4} class="text-ink-50"/>
                                    <span class="text-sm font-medium text-ink-50 underline">Elsewhere</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-col">
                            {/* Open in a new tab. */}
                            <a href="https://instagram.com/" target="_blank" rel="noreferrer" data-cursor="Visit" class="w-fit text-ink-50 text-xs font-semibold uppercase font-mono tracking-widest hover:text-ink transition-all"><span class="text-ink">[</span> <Reveal swap>INSTAGRAM</Reveal> <span class="text-ink">]</span></a>
                            <a href="https://github.com/" target="_blank" rel="noreferrer" data-cursor="Visit" class="w-fit text-ink-50 text-xs font-semibold uppercase font-mono tracking-widest hover:text-ink transition-all"><span class="text-ink">[</span> <Reveal swap>GITHUB</Reveal> <span class="text-ink">]</span></a>
                        </div>
                    </div>

                    {/* Optimised by Astro at 1x and 2x. */}
                    <Image
                        src={pfp}
                        alt="Nikolas Hošek"
                        widths={[200, 400]}
                        sizes="(max-width: 767px) 160px, 200px"
                        class="about__portrait h-40 w-40 object-cover md:h-50 md:w-50"
                    />
                </div>
            </div>
        </div>
    </section>

    {/* Last, so it sees every section. */}
    <AboutIntro />
</BaseLayout>
