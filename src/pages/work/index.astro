---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Project from '../../components/Project.astro';
import Masthead from '../../components/Masthead.astro';
import Reveal from '../../components/Reveal.astro';
import { ArrowDownRight } from '@lucide/astro';
import { getProjects } from '../../lib/work';

// Projects are staggered across three columns from md up, so the page
// reads as a composition, not a grid. On phones it's a single column.
const COLUMNS = ['md:col-start-1', 'md:col-start-2', 'md:col-start-2', 'md:col-start-3'];

const PROJECTS = (await getProjects()).map((project, i) => ({
  index: i + 1,
  name: project.data.title,
  category: project.data.role.join(' & ') || undefined,
  liveUrl: project.data.url,
  cover: project.data.cover,
  coverAlt: project.data.coverAlt,
  // Hover gallery is paused. To bring it back, import getFrames and pass
  // `frames: getFrames(project.id)`.
  // A fifth project wraps back to column 1.
  class: COLUMNS[i % COLUMNS.length],
}));

const total = PROJECTS.length;

// Two projects per row.
const rows = Array.from({ length: Math.ceil(total / 2) }, (_, r) =>
  PROJECTS.slice(r * 2, r * 2 + 2),
);
---

<BaseLayout title="Work" description="Selected web design and frontend development projects by Nikolas Hošek, a designer and developer in Olomouc, Czechia.">
    <section id="work" class="relative z-10 px-4 md:px-6">
        <div class="pt-24 pb-24 md:pt-30 md:pb-30">

            {/* Same spacing as /about. */}
            <div class="flex flex-col gap-14 md:gap-y-25">
            <div class="flex flex-col gap-14 md:grid md:grid-cols-3 md:gap-x-10">
                <div class="@container flex gap-10">
                <div>
                    <Masthead class="text-7xl sm:text-8xl md:text-7xl lg:text-8xl xl:text-9xl leading-none">Work</Masthead>
                </div>
                <div class="flex flex-col justify-between">
                    <span class="text-lg lg:text-2xl uppercase font-medium"><Reveal>({total})</Reveal></span>
                    <ArrowDownRight class="size-11 stroke-2 masthead__arrow"/>
                </div>
            </div>

            {/* One row on phones; `md:contents` makes it two grid cells on desktop. */}
            <div class="flex justify-between gap-6 md:contents">
                <div class="flex items-end">
                    <span class="text-[10px] font-semibold uppercase font-mono tracking-widest md:text-xs"><Reveal><span class="text-ink-50">Selected projects &mdash;</span> 2026</Reveal></span>
                </div>
                <div class="flex flex-col justify-end">
                    <Reveal class="text-ink-50 text-[10px] font-semibold uppercase font-mono tracking-widest md:text-xs">Digital</Reveal>
                    <Reveal class="text-ink-50 text-[10px] font-semibold uppercase font-mono tracking-widest md:text-xs">UI/UX Design</Reveal>
                    <Reveal class="text-[10px] font-semibold uppercase font-mono tracking-widest md:text-xs">Web Development</Reveal>
                </div>
                </div>
            </div>

            {rows.map((row) => (
                <div class="flex flex-col gap-14 md:grid md:grid-cols-3 md:gap-x-10">
                    {row.map((project) => <Project {...project} />)}
                </div>
            ))}
            </div>
        </div>
    </section>
</BaseLayout>
