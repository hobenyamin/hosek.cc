---
import BaseHead from '../components/BaseHead.astro';
import Frame from '../components/Frame.astro';
import RevealIntro from '../components/RevealIntro.astro';
import Cursor from '../components/Cursor.astro';
import { SITE } from '../consts';
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type } = Astro.props;

// "Work — Name". The homepage passes no title and gets the full site title.
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead title={pageTitle} description={description} image={image} type={type} />
    {/* Preloaded — it's the only font, so all text waits on it. */}
    <Font cssVariable='--font-satoshi' preload />

    {/* Entry animations only hide things when `html.js` is set, so the page
        still shows up if scripts fail. It has to be set here in <head>,
        before the first paint, or content flashes in and then hides.
        Not set under reduced motion, which turns every entry off. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
  </head>
  <body class="antialiased bg-paper text-ink">

    <Frame />

    <slot/>

    {/* Slides every <Reveal> line in. Last, so it sees the whole page. */}
    <RevealIntro />

    {/* Film grain over everything. Lives here so nothing can clip it. */}
    <div class="g_overlay" aria-hidden="true">
      <div class="g_grain_overlay u-grain-animate"></div>
    </div>

    {/* Custom cursor, above the grain. */}
    <Cursor />
  </body>
</html>
