---
import BaseHead from '../components/BaseHead.astro';
import Frame from '../components/Frame.astro';
import RevealIntro from '../components/RevealIntro.astro';
import Cursor from '../components/Cursor.astro';
import { SITE } from '../consts';
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type } = Astro.props;

// Page titles read "Thing — Name"; the homepage passes no title.
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead title={pageTitle} description={description} image={image} type={type} />
    <Font cssVariable='--font-satoshi'/>

    {/* Every entry animation holds its element in an offscreen state until it
        is released. Those holds are gated on `html.js` so they exist only when
        the scripts that release them will actually run: a page whose modules
        fail still renders normally rather than staying blank.

        IN <head>, not <body>. The stylesheet is in the head too, so a script
        placed in the body can run after the browser has already painted a
        frame — and that frame has no `html.js`, so every held element renders
        fully visible before snapping out of sight. That was the flash of
        content when navigating to /work and /about. The index page never
        showed it because the rail hides itself in plain CSS, with no flag.

        Reduced motion never sets it, which skips every entry at the source. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
  </head>
  <body class="antialiased bg-paper text-ink">

    <Frame />

    <slot/>

    {/* Sweeps every <Reveal> line in. Last in the body so it sees the whole
        page, including the frame. */}
    <RevealIntro />

    {/* Global grain overlay — sits above ALL content, never interactive.
        Rendered once here so no transformed ancestor can clip it. */}
    <div class="g_overlay" aria-hidden="true">
      <div class="g_grain_overlay u-grain-animate"></div>
    </div>

    {/* The custom cursor. Last in the body and above the grain (z-200 vs
        z-100), so nothing is ever painted over it. */}
    <Cursor />
  </body>
</html>
