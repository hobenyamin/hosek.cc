---
/**
 * Page-load animation: every <Reveal> line slides in from the left, with a
 * small overshoot. Lines go in order of where they sit on screen (left to
 * right, then top to bottom), not DOM order, so it reads as one sweep.
 */
---

<script>
  // /work projects and /about sections animate themselves, so skip them here.
  const lines = Array.from(
    document.querySelectorAll<HTMLElement>('[data-reveal]'),
  ).filter((line) => !line.closest('[data-project], [data-about]'));

  // Always set, even when nothing animates — the footer's status dot waits
  // for it and would stay hidden otherwise.
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      document.documentElement.classList.add('is-frame-in');
    });
  });

  if (lines.length > 0) run(lines);

  function run(lines: HTMLElement[]) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduced.matches) return;

    const inners = lines
      .map((line) => ({
        el: line.querySelector<HTMLElement>('[data-reveal-inner]'),
        box: line.getBoundingClientRect(),
        order: Number(line.dataset.revealOrder ?? Number.NaN),
      }))
      .filter((entry): entry is { el: HTMLElement; box: DOMRect; order: number } =>
        entry.el !== null,
      )
      // An explicit `order` wins; otherwise left to right, then top to bottom.
      .sort((a, b) => {
        if (!Number.isNaN(a.order) || !Number.isNaN(b.order)) {
          return (Number.isNaN(a.order) ? Infinity : a.order) -
            (Number.isNaN(b.order) ? Infinity : b.order);
        }
        return a.box.left - b.box.left || a.box.top - b.box.top;
      })
      .map((entry) => entry.el);

    // The lines are already hidden by CSS (see Reveal.astro). Wait two frames
    // so that hidden state is painted, or the animation may not run.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        inners.forEach((el, i) => {
          // Set the end position inline so it beats the CSS hide once the
          // animation finishes; `fill: backwards` holds the start until then.
          el.style.transform = 'translateX(0%)';
          el.animate(
            { transform: ['translateX(-110%)', 'translateX(0%)'] },
            {
              duration: 900,
              delay: i * 55,
              fill: 'backwards',
              // Slight overshoot, then settles.
              easing: 'cubic-bezier(0.16, 1.11, 0.3, 1)',
            },
          ).finished.then(
            // Drop the GPU hint once it's done moving.
            () => { el.style.willChange = 'auto'; },
            () => {},
          );
        });
      });
    });
  }
</script>
