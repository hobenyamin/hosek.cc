---
/**
 * The big page word ("Work", "About"). It rises up from below on load, slower
 * than the small text, and the arrow next to it swings in last.
 */
interface Props {
  /** The display word. */
  children?: unknown;
  class?: string;
}

const { class: className = '' } = Astro.props;
---

{/* The page's <h1>. */}
<h1 class={`masthead ${className}`} data-masthead>
  <span class="masthead__mask">
    <span class="masthead__word"><slot /></span>
  </span>
</h1>

<style>
  /* Hides the word while it's below the line. */
  .masthead__mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    /* Room for descenders. */
    padding-block: 0.08em;
    margin-block: -0.08em;
  }

  .masthead__word {
    display: inline-block;
    will-change: transform;
  }

  /* Starts below the line (only with JS — see BaseLayout). */
  :global(html.js) .masthead__word {
    transform: translateY(110%);
  }

  :global(html.js) [data-masthead].is-in .masthead__word {
    transform: translateY(0);
    /* Slow and eased, after the small text has started. */
    transition: transform 1100ms cubic-bezier(0.16, 1, 0.3, 1) 260ms;
  }

  /* The arrow fades in and swings into place last. Global because it's a
     lucide icon from another component. */
  :global(html.js .masthead__arrow) {
    opacity: 0;
    /* Starts pointing up-right, swings down-right like a needle. */
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
  }

  /* Keyed off <html> because the arrow sits in a different place on each page. */
  :global(html.js.is-in .masthead__arrow) {
    opacity: 1;
    transform: rotate(0deg);
    transition:
      opacity 600ms ease-out 900ms,
      transform 800ms cubic-bezier(0.16, 1, 0.3, 1) 900ms;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .masthead__word,
    :global(html.js .masthead__arrow) {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  // Two frames so the hidden state is painted before it animates.
  const words = document.querySelectorAll<HTMLElement>('[data-masthead]');

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      for (const word of words) word.classList.add('is-in');
      // For the arrow.
      document.documentElement.classList.add('is-in');
    });
  });
</script>
