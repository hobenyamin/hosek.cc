---
/**
 * A line of text inside a clipping box. Used two ways:
 *
 *   Entry — RevealIntro slides the text in from the left on load.
 *   Swap  — with `swap`, a copy sits below the text and hover slides it up
 *           one line, so the label rolls over.
 *
 * Entry moves `.reveal__inner` and the swap moves `.reveal__swap` inside
 * it, so the two never fight over the same transform.
 */
interface Props {
  /** Wrapper element. */
  as?: 'div' | 'span' | 'li';
  /** Entry order; lower goes first. Default is screen position. */
  order?: number;
  /** Roll to a copy of the label on hover (the copy is hidden from screen readers). */
  swap?: boolean;
  class?: string;
}

const { as: Tag = 'span', order, swap = false, class: className = '' } = Astro.props;
---

<Tag class={`reveal ${className}`} data-reveal data-reveal-order={order}>
  <span class="reveal__inner" data-reveal-inner>
    {
      swap ? (
        <span class="reveal__swap">
          <span class="reveal__face"><slot /></span>
          <span class="reveal__face" aria-hidden="true"><slot /></span>
        </span>
      ) : (
        <slot />
      )
    }
  </span>
</Tag>

<style>
  /* The clipping box. */
  .reveal {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  .reveal__inner {
    display: inline-block;
    /* Avoids a stutter on the first frame. */
    will-change: transform;
  }

  /* Hidden to the left until RevealIntro slides it in. Only with JS, so the
     text still shows if scripts fail. */
  :global(html.js) .reveal__inner {
    transform: translateX(-110%);
  }

  /* These animate some other way (or not at all), so don't hide them here. */
  :global(html.js [data-project]) .reveal__inner,
  :global(html.js [data-about]) .reveal__inner,
  :global(html.js [data-no-entry]) .reveal__inner {
    transform: none;
  }

  /* --------------------------------------------------------------- swap */

  /* Exactly one line tall, so only one copy shows. */
  .reveal:has(.reveal__swap) {
    height: 1lh;
  }

  .reveal__swap {
    display: block;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal__face {
    display: block;
    /* One line each, so the -50% move lands exactly. */
    line-height: inherit;
    white-space: nowrap;
  }

  /* Hovering the whole link or button rolls the label up one line. */
  :global(:is(a, button, [data-swap-host]):hover) .reveal__swap,
  :global(:is(a, button, [data-swap-host]):focus-visible) .reveal__swap {
    transform: translateY(-50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal__swap {
      transition: none;
    }
  }
</style>
