---
/**
 * The custom cursor: a dot plus a small label that appears over anything
 * with `data-cursor`.
 *
 *   <a data-cursor="Visit">                    label on hover
 *   <span data-cursor="Soon" data-cursor-mute> dimmed label, nothing to click
 *   <button data-cursor="Copy" data-cursor-done="Copied">
 *
 * When an element sets `data-cursor-state="done"`, the label switches to its
 * `data-cursor-done` text (`failed` works the same way).
 *
 * The normal cursor is only hidden over labelled elements, and not at all on
 * touch screens.
 */
---

{/* Hidden from screen readers — the labels repeat what the elements already say. */}
<div class="cursor" data-cursor-root aria-hidden="true">
  <div class="cursor__dot" data-cursor-dot></div>
  <div class="cursor__label" data-cursor-label><span data-cursor-text></span></div>
</div>

<style>
  .cursor {
    /* All the cursor settings. Change these, not the rules below. */

    /* Colour of the dot, by state. */
    --cursor-mark: var(--color-ink);
    --cursor-mark-active: var(--color-ink);
    /* Muted, e.g. "Soon". */
    --cursor-mark-mute: var(--color-ink-50);
    /* After a successful copy. */
    --cursor-mark-done: var(--color-signal);

    /* The label chip beside the dot. */
    --cursor-label-bg: var(--color-ink);
    --cursor-label-ink: var(--color-paper);
    --cursor-label-mute-bg: var(--color-ink-20);
    --cursor-label-mute-ink: var(--color-ink);
    --cursor-label-done-bg: var(--color-signal);
    --cursor-label-done-ink: var(--color-paper);

    /* Diameter of the dot. */
    --cursor-dot-size: 0.5rem;
    /* Gap between the pointer and the label. */
    --cursor-label-offset: 0.875rem;

    /* Motion. `--cursor-fade` must match FADE_MS in the script. */
    --cursor-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --cursor-turn: 320ms;
    --cursor-fade: 420ms;

    position: fixed;
    top: 0;
    left: 0;
    z-index: 200;
    pointer-events: none;
    /* Hidden until the mouse first moves. */
    opacity: 0;
    will-change: transform;
  }

  :global(html.has-cursor) .cursor[data-ready] {
    opacity: 1;
  }

  /* The dot grows in with the label. */
  .cursor__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--cursor-dot-size);
    height: var(--cursor-dot-size);
    margin: calc(var(--cursor-dot-size) / -2) 0 0 calc(var(--cursor-dot-size) / -2);
    border-radius: 9999px;
    background: var(--cursor-mark);
    opacity: 0;
    transform: scale(0);
    transition:
      transform var(--cursor-turn) var(--cursor-ease),
      opacity var(--cursor-turn) var(--cursor-ease),
      background-color 200ms ease-out;
  }

  .cursor[data-active] .cursor__dot {
    background: var(--cursor-mark-active);
    opacity: 1;
    transform: scale(1);
  }

  .cursor[data-mute] .cursor__dot {
    background: var(--cursor-mark-mute);
  }

  .cursor[data-state='done'] .cursor__dot {
    background: var(--cursor-mark-done);
  }

  /*
    The label sits below-right of the pointer, in the same mono style as the
    frame text.
  */
  .cursor__label {
    position: absolute;
    top: 0;
    left: 0;
    margin: var(--cursor-label-offset) 0 0 var(--cursor-label-offset);
    padding: 0.35em 0.6em;
    background: var(--cursor-label-bg);
    color: var(--cursor-label-ink);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    border-radius: 2px;

    /* Wipes in from the left, like the covers and the menu. */
    clip-path: inset(0 100% 0 0);
    opacity: 0;
    transition:
      clip-path var(--cursor-fade) var(--cursor-ease),
      opacity 200ms ease-out;
  }

  .cursor[data-active] .cursor__label {
    clip-path: inset(0 0 0 0);
    opacity: 1;
  }

  /* Muted: nothing to click. */
  .cursor[data-mute] .cursor__label {
    background: var(--cursor-label-mute-bg);
    color: var(--cursor-label-mute-ink);
  }

  /* Done: the accent colour. */
  .cursor[data-state='done'] .cursor__label {
    background: var(--cursor-label-done-bg);
    color: var(--cursor-label-done-ink);
  }

  /* Failed: muted, no error colour. */
  .cursor[data-state='failed'] .cursor__label {
    background: var(--cursor-label-mute-bg);
    color: var(--cursor-label-mute-ink);
  }

  /* Reduced motion: no wipe, the label just appears. */
  @media (prefers-reduced-motion: reduce) {
    .cursor__dot,
    .cursor__label {
      transition: none;
    }
  }
</style>

<script>
  /*
    One listener for the whole page. Labels are read on hover, so elements
    added later just work.
  */
  const root = document.querySelector<HTMLElement>('[data-cursor-root]');
  const text = root?.querySelector<HTMLElement>('[data-cursor-text]');

  // Mouse only — touch screens get no custom cursor.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (root && text && fine.matches) {
    // Turns on the `cursor: none` rule at the bottom.
    document.documentElement.classList.add('has-cursor');

    let pointerX = 0;
    let pointerY = 0;
    let frame = 0;
    // The element whose label is showing.
    let active: HTMLElement | null = null;

    /* How long the label takes to fade out (matches --cursor-fade). */
    const FADE_MS = 420;
    let clearFace = 0;

    /* Move the cursor at most once per frame, however fast the mouse reports. */
    const render = () => {
      frame = 0;
      root.style.transform = `translate3d(${pointerX}px, ${pointerY}px, 0)`;
    };

    const schedule = () => {
      if (reduced.matches) {
        render();
        return;
      }
      if (!frame) frame = requestAnimationFrame(render);
    };

    document.addEventListener(
      'pointermove',
      (event) => {
        // Ignore pen and touch.
        if (event.pointerType !== 'mouse') return;

        pointerX = event.clientX;
        pointerY = event.clientY;

        // Show it on the first move.
        if (!root.hasAttribute('data-ready')) root.setAttribute('data-ready', '');

        schedule();
      },
      { passive: true },
    );

    /* `pointerover` bubbles, so one listener works for every element. */
    const sync = (target: EventTarget | null) => {
      const el =
        target instanceof Element ? target.closest<HTMLElement>('[data-cursor]') : null;

      if (!el) {
        active = null;

        root.removeAttribute('data-active');

        /*
          Keep the colours until the fade-out ends, or a grey label would turn
          black on its way out.
        */
        clearTimeout(clearFace);
        clearFace = window.setTimeout(() => {
          root.removeAttribute('data-mute');
          root.removeAttribute('data-state');
        }, FADE_MS);

        return;
      }

      // Came back before it finished fading: keep the colours.
      clearTimeout(clearFace);

      active = el;

      /* A state ("Copied") wins over the normal label. */
      const state = el.getAttribute('data-cursor-state');
      const resting = el.getAttribute('data-cursor') ?? '';
      const stateLabel = state ? el.getAttribute(`data-cursor-${state}`) : null;

      text.textContent =
        stateLabel ?? (state === 'failed' ? 'Press to copy' : resting);
      root.setAttribute('data-active', '');
      root.toggleAttribute('data-mute', el.hasAttribute('data-cursor-mute'));

      if (state) root.setAttribute('data-state', state);
      else root.removeAttribute('data-state');
    };

    document.addEventListener('pointerover', (event) => sync(event.target));

    /*
      Update the label when an element changes under a still pointer, like a
      copy button turning "Copied" or a rail cover passing the centre.
    */
    const observer = new MutationObserver(() => {
      if (active) sync(active);
    });

    observer.observe(document.body, {
      subtree: true,
      attributes: true,
      attributeFilter: [
        'data-cursor',
        'data-cursor-mute',
        'data-cursor-state',
        'data-cursor-done',
        'data-cursor-failed',
      ],
    });

    // Hide it when the pointer leaves the window.
    document.addEventListener('pointerout', (event) => {
      if (!event.relatedTarget) {
        root.removeAttribute('data-ready');
        sync(null);
      }
    });
  }
</script>

<style is:global>
  /*
    Hide the normal cursor over labelled elements only. `!important` beats
    `cursor: pointer` from utility classes.
  */
  html.has-cursor [data-cursor],
  html.has-cursor [data-cursor] * {
    cursor: none !important;
  }
</style>
