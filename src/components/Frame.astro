---
import Reveal from './Reveal.astro';
import { CONTACT, NAV } from '../consts';
import { publicPath } from '../lib/path';

const path = publicPath(Astro.url.pathname);
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

{/* Header and footer use the same 3-column grid as the pages. */}
<div class="frame pointer-events-none">
  <header class="fixed inset-x-0 top-0 z-50 grid grid-cols-2 gap-6 px-4 py-4 md:grid-cols-3 md:gap-10 md:px-6">
    <nav aria-label="Main">
      {/* On phones the links collapse into this button. Its label rolls to "Close" when open. */}
      <button
        type="button"
        class="pointer-events-auto block text-sm font-semibold transition-colors hover:text-ink md:hidden"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-toggle
      >
        <Reveal>
          <span class="menu-toggle__faces">
            <span class="menu-toggle__face">Menu</span>
            <span class="menu-toggle__face" aria-hidden="true">Close</span>
          </span>
        </Reveal>
      </button>

      <ul class="hidden gap-4 md:flex">
        {
          NAV.map(({ label, href }) => (
            <li>
              {/* The cursor shows where the link goes. */}
              <a
                class="pointer-events-auto block text-sm font-semibold text-ink-50 transition-colors hover:text-ink aria-[current=page]:text-ink"
                data-cursor={label}
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
              >
                <Reveal swap>{label}</Reveal>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Dimmed so only the nav is full black. */}
    <div class="hidden flex-col md:flex">
      <Reveal class="text-sm font-semibold">Designer &amp; Developer</Reveal>
      <Reveal class="text-ink-50 text-sm font-semibold">Based in Czechia</Reveal>
    </div>

    {/* Click copies the address. `aria-label` says so for screen readers. */}
    {/* items-start: a stretched <button> centres its text vertically. */}
    <div class="flex items-start justify-end">
      <button
        type="button"
        class="pointer-events-auto block text-sm font-semibold text-ink-50 transition-colors hover:text-ink"
        data-copy={CONTACT.email}
        data-cursor="Copy"
        data-cursor-done="Copied"
        aria-label={`Copy email address ${CONTACT.email}`}
      >
        <Reveal swap>{CONTACT.email}</Reveal>
      </button>
    </div>
  </header>

  <footer class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 items-end gap-6 px-4 py-4 md:grid-cols-3 md:gap-10 md:px-6">
    <a class="pointer-events-auto hidden text-sm font-semibold md:block w-fit" href="/" data-cursor="Index"><Reveal swap>Nikolas Hošek</Reveal></a>

    <p class="flex items-center gap-2 text-sm font-semibold">
      {/* The dot pulses, and grows in on load. */}
      <span class="frame__dot inline-block size-1.5 shrink-0 rounded-full bg-signal animate-pulse"></span>
      <Reveal>Available <span class="hidden sm:inline">for work</span></Reveal>
    </p>

    <div class="flex justify-end">
      <time class="text-sm font-semibold tabular-nums" data-clock>
        <Reveal><span data-clock-hm>--:--</span><span class="hidden sm:inline" data-clock-s>:--</span></Reveal>
      </time>
    </div>
  </footer>

  {/* Mobile menu. `inert` keeps its links unreachable while it's closed. */}
  <div
    id="menu"
    class="menu pointer-events-none fixed inset-0 z-40 flex flex-col justify-center bg-paper px-4 md:hidden"
    data-menu
    inert
  >
    <ul class="flex list-none flex-col gap-2 p-0">
      {
        NAV.map(({ label, href }, i) => (
          <li class="menu__item" style={`--menu-i:${i}`}>
            <a
              class="block py-2 text-5xl font-medium text-ink-50 transition-colors hover:text-ink aria-[current=page]:text-ink"
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="menu__item mt-10 flex flex-col gap-1" style={`--menu-i:${NAV.length}`}>
      <a class="text-sm font-semibold text-ink-50 transition-colors hover:text-ink" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <span class="text-sm font-semibold text-ink-50">Based in Czechia</span>
    </div>
  </div>
</div>

<style>
  /* Status dot entry. Scale only — the pulse already animates opacity. */
  :global(html.js) .frame__dot {
    transform: scale(0);
  }

  :global(html.js.is-frame-in) .frame__dot {
    transform: scale(1);
    /* Lands with the "Available" text. */
    transition: transform 620ms cubic-bezier(0.16, 1.4, 0.3, 1) 520ms;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .frame__dot {
      transform: none;
      transition: none;
    }
  }

  /* ------------------------------------------------------------- menu */

  /* Menu/Close label roll. */
  .menu-toggle__faces {
    display: block;
    height: 1lh;
    overflow: hidden;
  }

  .menu-toggle__face {
    display: block;
    line-height: inherit;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  [aria-expanded='true'] .menu-toggle__face {
    transform: translateY(-100%);
  }

  /* The panel wipes down from the top. */
  .menu {
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 620ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 620ms;
  }

  .menu[data-open] {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    pointer-events: auto;
    transition:
      clip-path 620ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s;
  }

  /* Items rise in one after another. */
  .menu__item {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 400ms ease-out,
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu[data-open] .menu__item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(140ms + var(--menu-i) * 70ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu__item,
    .menu-toggle__face {
      transition: none;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import { rollSwap } from '../lib/swap';

  // Live Czech time in the footer. Seconds are a separate element because
  // small screens hide them.
  {
    const el = document.querySelector<HTMLElement>("[data-clock]");
    const hm = el?.querySelector<HTMLElement>("[data-clock-hm]");
    const sec = el?.querySelector<HTMLElement>("[data-clock-s]");

    if (el && hm && sec) {
      const fmt = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/Prague",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      });
      const tick = () => {
        const [h, m, s] = fmt.format(new Date()).split(":");
        hm.textContent = `${h}:${m}`;
        sec.textContent = `:${s}`;
        el.setAttribute("datetime", `${h}:${m}:${s}`);
      };
      tick();
      setInterval(tick, 1000);
    }
  }

  /* Mobile menu. Scrolling is paused through Lenis so the page doesn't jump. */
  {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-menu]');

    if (toggle && panel) {
      const setOpen = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));

        if (open) {
          panel.setAttribute('data-open', '');
          panel.removeAttribute('inert');
          window.lenisInstance?.stop();
          // No Lenis under reduced motion, so lock the page directly too.
          document.documentElement.style.overflow = 'hidden';
        } else {
          panel.removeAttribute('data-open');
          panel.setAttribute('inert', '');
          window.lenisInstance?.start();
          document.documentElement.style.overflow = '';
        }
      };

      const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

      toggle.addEventListener('click', () => setOpen(!isOpen()));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen()) {
          setOpen(false);
          // Put focus back on the button.
          toggle.focus();
        }
      });

      /*
        Links don't close the panel — the next page loads with it closed anyway,
        and animating it closed first looks like a stutter. Only close it for
        mailto: links and links to the current page, where nothing navigates.
      */
      for (const link of panel.querySelectorAll('a')) {
        link.addEventListener('click', () => {
          const href = link.getAttribute('href') ?? '';
          const target = new URL(href, location.href);

          const leaves =
            target.protocol === 'http:' || target.protocol === 'https:';
          const samePage =
            leaves &&
            target.pathname.replace(/\/$/, '') === location.pathname.replace(/\/$/, '');

          if (!leaves || samePage) setOpen(false);
        });
      }

      // Close it if the window grows to desktop size.
      const desktop = window.matchMedia('(min-width: 768px)');
      desktop.addEventListener('change', (event) => {
        if (event.matches && isOpen()) setOpen(false);
      });
    }
  }

  /*
    Copy to clipboard on any <button data-copy>. The button shows "Copied"
    through the cursor, or on phones (no cursor) by rolling its label to
    "Copied".
  */
  for (const el of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    let timer = 0;

    /*
      What pressed it. Read from pointerdown, not the click: iOS Safari reports
      taps as `pointerType: "mouse"` on the click event.
    */
    let pressedBy = '';
    el.addEventListener('pointerdown', (event) => {
      pressedBy = event.pointerType;
    });

    el.addEventListener('click', async (event) => {
      const value = el.getAttribute('data-copy');
      if (!value) return;

      // `detail` is 0 for keyboard clicks.
      const byMouse = pressedBy === 'mouse' && event.detail !== 0;
      pressedBy = '';

      const ok = await copy(value);

      el.setAttribute('data-cursor-state', ok ? 'done' : 'failed');
      clearTimeout(timer);
      timer = window.setTimeout(() => el.removeAttribute('data-cursor-state'), 1600);

      // Anything but a mouse (tap, keyboard) has no cursor label to read.
      if (!byMouse) {
        rollSwap(
          el,
          1600,
          ok
            ? { text: el.getAttribute('data-cursor-done') ?? 'Copied', tone: 'done' }
            : { text: el.getAttribute('data-cursor-failed') ?? "Couldn't copy", tone: 'failed' },
        );
      }
    });

    // Reset when the pointer leaves.
    el.addEventListener('pointerleave', () => {
      clearTimeout(timer);
      el.removeAttribute('data-cursor-state');
    });
  }

  /*
    The Clipboard API, falling back to the old select-and-copy trick where it's
    missing: plain http:// (a phone on the dev server) and some in-app browsers.
  */
  async function copy(value: string) {
    try {
      await navigator.clipboard.writeText(value);
      return true;
    } catch {}

    const field = document.createElement('textarea');
    field.value = value;
    field.setAttribute('readonly', '');
    // Off screen; 16px so iOS doesn't zoom in on it.
    field.style.cssText = 'position:fixed;top:0;left:-9999px;font-size:16px;';
    document.body.appendChild(field);
    field.select();
    field.setSelectionRange(0, value.length);

    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {}

    field.remove();
    return ok;
  }

  /*
    Smooth scrolling (Lenis). Off under reduced motion, and on the homepage,
    where the page doesn't scroll and the rail moves itself.
  */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const isRail = document.documentElement.classList.contains('rail-host');

  if (!reduced.matches && !isRail) {
    window.lenisInstance = new Lenis({ autoRaf: true, respectReducedMotion: false });
  }
</script>
