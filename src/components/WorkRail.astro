---
import { Image } from 'astro:assets';
import type { Project } from '../lib/work';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const total = projects.length;

/** "03/04" — always two digits so the counter never changes width. */
const pad = (n: number) => String(n).padStart(2, '0');

/*
  Without JS this is a plain list of linked covers. With JS it becomes the
  infinite scrolling rail: the same <li>s, just positioned by the script.
*/
---

<section class="rail relative" data-rail aria-label="Selected work">
  <div class="rail__bg hidden bg-rail-bg fixed inset-0 z-0"></div>

  <ol class="rail__list grid list-none justify-items-center gap-20 p-0" data-rail-list>
    {
      projects.map((project, i) => {
        const { title, year, role, cover, coverAlt } = project.data;
        const discipline = role.join(' & ');

        return (
          <li
            class="rail__item "
            data-rail-item
            data-counter={`${pad(i + 1)}/${pad(total)}`}
            data-title={title}
            data-year={String(year)}
            data-role={discipline}
          >
            {/* Links to /work for now. Point it at the project page once those exist. */}
            <a
              class="rail__link block w-[var(--rail-w)] text-rail-ink no-underline"
              href="/work"
              data-cursor="Work"
            >
              {cover ? (
                <Image
                  class="rail__cover block size-full object-cover aspect-[var(--rail-rw)/var(--rail-rh)]"
                  src={cover}
                  alt={coverAlt ?? ''}
                  widths={[320, 640, 960, 1440]}
                  sizes="(max-width: 767px) 88vw, 58vh"
                  loading="eager"
                />
              ) : (
                <span class="rail__cover block size-full aspect-[var(--rail-rw)/var(--rail-rh)] bg-[repeating-linear-gradient(45deg,#d8d5d1,#d8d5d1_8px,#e4e1dd_8px,#e4e1dd_16px)]" aria-hidden="true" />
              )}

              <span class="rail__caption mt-3.5 grid gap-1.5 font-mono text-[10px] font-semibold tracking-widest uppercase md:text-xs">
                <span>{title}</span>
                <span class="text-rail-dim">
                  {discipline}
                  {discipline && ' — '}
                  {year}
                </span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>

  {/*
    Caption of the centred project. Hidden from screen readers — the links
    already have the names.
  */}
  <div
    class="rail__meta hidden flex-col items-center justify-center gap-4 font-mono text-[10px] font-semibold leading-relaxed tracking-widest text-rail-ink uppercase md:flex-row md:gap-10 md:text-xs"
    aria-hidden="true"
  >
    {/* Counter and title: one line on phones, two on desktop. */}
    {/* The script writes the text into the inner spans. */}
    <div class="flex w-[88vw] max-w-[22rem] shrink-0 grow-0 items-baseline justify-center gap-2 md:w-auto md:flex-1 md:basis-0 md:flex-col md:items-end md:gap-0 md:text-right">
      <p class="rail__line m-0 font-black text-ink-50">
        <span class="rail__line-in" data-rail-counter></span>
      </p>
      {/* The title is in the normal font; the rest is mono. */}
      <p class="rail__line m-0 font-sans text-base font-medium normal-case tracking-normal text-rail-ink md:text-lg">
        <span class="rail__line-in" data-rail-title></span>
      </p>
    </div>

    {/* Spacer the size of the centred cover, so the captions sit around it. */}
    <div
      class="h-[calc(var(--rail-w)*var(--rail-rh)/var(--rail-rw))] w-auto shrink-0 grow-0 md:h-auto md:w-[var(--rail-w)]"
    ></div>

    {/* Role and year: one line on phones, two on desktop. */}
    <div class="flex w-[88vw] max-w-[22rem] shrink-0 grow-0 flex-row-reverse items-baseline justify-center gap-2 md:w-auto md:flex-1 md:basis-0 md:flex-col md:items-start md:gap-0 md:text-left">
      <p class="rail__line m-0 text-rail-dim">
        <span class="rail__line-in" data-rail-year></span>
      </p>
      <p class="rail__line m-0 text-rail-ink">
        <span class="rail__line-in" data-rail-role></span>
      </p>
    </div>
  </div>
</section>

{/* Runs right away so the plain list never flashes. */}
<script is:inline>
  document.querySelector('[data-rail]').classList.add('rail--live');
  document.documentElement.classList.add('rail-host');
</script>

<style>
  @reference '../styles/global.css';

  /*
    Most styling is in the markup. This is just the live-rail state and the
    phone tuning.
  */

  @media (max-width: 767px) {
    .rail {
      --rail-w: 88vw;
      --rail-spread: 1.55;
      --rail-clear: 64;

      /* Phones: bigger far covers, so only 2–3 show on each side. */
      --rail-thumb-min: 0.28;

      /* A bit more space between covers. */
      --rail-gap: 0.07;
    }
  }

  /* ------------------------------------------------------------------ live */

  .rail--live .rail__bg {
    display: block;
  }

  /*
    100svh, not inset: 0 — a fixed height, so the rail's centre never moves.
    `touch-action: none` hands every swipe to the script instead of the
    browser.
  */
  .rail--live .rail__list {
    display: block;
    position: fixed;
    inset: 0 0 auto;
    height: 100svh;
    z-index: 1;
    touch-action: none;
  }

  /*
    Hidden until the script has placed the covers, or they flash stacked in
    the middle.
  */
  .rail--live .rail__list {
    visibility: hidden;
  }

  .rail--live.rail--placed .rail__list {
    visibility: visible;
  }

  /*
    Entry: the rail grows into place after the header and footer text.
    Scales the list, not the covers, because the script rewrites the covers'
    transforms every frame.
  */
  .rail--live .rail__list {
    transform: scale(var(--rail-zoom, 0.82));
    transform-origin: 50% 1%;
    opacity: 0;
  }

  .rail--live.rail--placed .rail__list {
    transform: scale(1);
    opacity: 1;
    transition:
      transform 1100ms cubic-bezier(0.16, 1, 0.3, 1) 400ms,
      opacity 700ms ease-out 400ms;
  }

  /* No entry under reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .rail--live .rail__list {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }

  .rail--live .rail__item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--rail-w);
    aspect-ratio: var(--rail-rw) / var(--rail-rh);
    /* The link scales inside the box, so smaller covers are smaller to click. */
    pointer-events: none;
    will-change: transform, opacity;
  }

  .rail--live .rail__link {
    width: 100%;
    height: 100%;
    pointer-events: auto;
    transform-origin: 50% 50%;
  }

  /* Still a real link for screen readers, just not drawn. */
  .rail--live .rail__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Caption stays fixed over the rail. */
  .rail--live .rail__meta {
    display: flex;
    position: fixed;
    inset: 0 0 auto;
    height: 100svh;
    z-index: 2;
    pointer-events: none;
  }

  /* ------------------------------------------------------- meta entry */

  /*
    The caption lines slide out on load: left column from the left, right
    column from the right. Only once — not on every project change.
  */
  .rail--live .rail__line {
    overflow: hidden;
    padding-block: 0.15em;
    margin-block: -0.15em;
  }

  .rail--live .rail__line-in {
    display: inline-block;
    transform: translateX(var(--rail-meta-from, -110%));
    opacity: 0;
    will-change: transform;
  }

  /* Right column comes from the right. */
  .rail--live .rail__meta > :last-child .rail__line-in {
    --rail-meta-from: 110%;
  }

  .rail--live.rail--placed .rail__line-in {
    transform: translateX(0);
    opacity: 1;
    /* Lands with the rail. */
    transition:
      transform 900ms cubic-bezier(0.16, 1.11, 0.3, 1) var(--rail-meta-delay, 500ms),
      opacity 500ms ease-out var(--rail-meta-delay, 500ms);
  }

  .rail--live .rail__meta .rail__line:nth-child(2) .rail__line-in {
    --rail-meta-delay: 580ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .rail--live .rail__line-in {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }

</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-rail]');
  if (root) initRail(root);

  function initRail(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>('[data-rail-list]')!;

    const originals = Array.from(list.querySelectorAll<HTMLElement>('[data-rail-item]'));
    const count = originals.length;
    if (count === 0) return;

    const out = {
      counter: root.querySelector<HTMLElement>('[data-rail-counter]')!,
      title: root.querySelector<HTMLElement>('[data-rail-title]')!,
      year: root.querySelector<HTMLElement>('[data-rail-year]')!,
      role: root.querySelector<HTMLElement>('[data-rail-role]')!,
    };

    /*
      The loop is endless: each cover's position is its distance from the
      centre, wrapped around. The page doesn't scroll — `current` is the
      rail's own scroll position, easing towards `target`, which wheel, touch
      and keys move.
    */
    let current = 0;
    let target = 0;

    let items: HTMLElement[] = [];
    let step = 1;
    let loop = 1;
    let activeH = 0;
    let gapPx = 0;
    let clearPx = 0;
    let spread = 0.9;
    let curve = 2.2;
    let thumbMin = 0.16;
    let fadeStep = 0.12;
    let fadeMin = 0.4;
    let cullAt = 0;
    let halfView = 0;
    let active = -1;

    /*
      Covers differ in size, so spacing is looked up in `ladder`: the running
      total of (cover height + gap) from the centre outwards.
    */
    // Small enough steps that covers never overlap.
    const RUNG = 0.005;
    let ladder: number[] = [0];
    let reachSlots = 0;

    // The frame loop only runs while something is moving.
    let running = false;
    let lastTime = 0;
    // A finger is on the rail: it follows the finger instead of easing.
    let dragging = false;

    // Share of the remaining distance covered per 60fps frame, like Lenis.
    let lerp = 0.1;

    measure();
    render();

    // Placed — safe to show.
    root.classList.add('rail--placed');

    /** Builds the spacing table out to the edge of the screen. */
    function buildLadder() {
      ladder = [0];
      let rise = 0;
      let slot = 0;
      while (rise < cullAt && ladder.length < 20000) {
        rise += (tileHeight(slot + RUNG / 2) + gapPx) * RUNG;
        slot += RUNG;
        ladder.push(rise);
      }
      reachSlots = slot;
    }

    /** Reads the settings from CSS and sizes everything from the cover size. */
    function measure() {
      const style = getComputedStyle(root);
      const num = (name: string, fallback: number) => {
        const value = parseFloat(style.getPropertyValue(name));
        return Number.isFinite(value) ? value : fallback;
      };

      spread = num('--rail-spread', 0.9);
      curve = num('--rail-curve', 2.2);
      thumbMin = num('--rail-thumb-min', 0.16);
      fadeStep = num('--rail-fade', 0.12);
      fadeMin = num('--rail-fade-min', 0.4);
      lerp = Math.min(1, Math.max(0.01, num('--rail-lerp', 0.1)));

      activeH = originals[0].offsetHeight;
      gapPx = activeH * num('--rail-gap', 0.03);
      clearPx = num('--rail-clear', 0);
      halfView = viewH() / 2;
      cullAt = halfView + activeH;

      // Scroll distance per project, as a share of the screen height.
      step = Math.max(1, viewH() * num('--rail-step', 0.34));

      buildLadder();

      // Enough copies to fill the screen both ways.
      const copies = Math.max(1, Math.ceil((Math.ceil(reachSlots) * 2 + 2) / count));
      if (items.length !== count * copies) clone(copies);

      loop = items.length * step;
    }

    /** Screen height. The page is locked to 100svh, so this matches the layers. */
    function viewH() {
      return document.documentElement.clientHeight;
    }

    /** Copies the covers until they fill the screen. */
    function clone(copies: number) {
      for (const el of list.querySelectorAll('[data-rail-clone]')) el.remove();

      for (let c = 1; c < copies; c++) {
        for (const original of originals) {
          const copy = original.cloneNode(true) as HTMLElement;
          copy.setAttribute('data-rail-clone', '');
          copy.setAttribute('aria-hidden', 'true');
          for (const link of copy.querySelectorAll('a')) link.tabIndex = -1;
          list.appendChild(copy);
        }
      }

      items = Array.from(list.querySelectorAll<HTMLElement>('[data-rail-item]'));
    }

    /** Distance from the centre to cover `i`, wrapped around the loop. */
    function distance(i: number, offset: number) {
      const raw = i * step - offset;
      return (((raw + loop / 2) % loop) + loop) % loop - loop / 2;
    }

    function render() {
      const offset = current;

      for (let i = 0; i < items.length; i++) {
        const el = items[i];
        const s = distance(i, offset) / step;
        const away = Math.abs(s);
        const y = offsetAt(s);
        const h = tileHeight(away);

        /*
          Cursor label for each cover: "Work" in the centre (opens /work), "Next"
          below and "Previous" above (click brings it to the centre, muted).
          Only written when it changes.
        */
        const centred = away < 0.5;
        const label = centred ? 'Work' : s > 0 ? 'Next' : 'Previous';
        const link = el.firstElementChild as HTMLElement;

        if (link.getAttribute('data-cursor') !== label) {
          link.setAttribute('data-cursor', label);
          link.toggleAttribute('data-cursor-mute', !centred);
        }

        // Skip covers that are off screen.
        if (Math.abs(y) - h / 2 > halfView) {
          if (el.style.visibility !== 'hidden') el.style.visibility = 'hidden';
          continue;
        }
        if (el.style.visibility) el.style.visibility = '';

        const opacity = Math.max(fadeMin, 1 - away * fadeStep);

        el.style.transform = `translate(-50%, -50%) translate3d(0, ${y.toFixed(2)}px, 0)`;
        el.style.opacity = opacity.toFixed(3);
        el.style.zIndex = String(1000 - Math.round(away * 10));

        link.style.transform = `scale(${(h / activeH).toFixed(4)})`;
      }

      const next = mod(Math.round(offset / step), count);
      if (next !== active) {
        active = next;
        setMeta(originals[next]);
      }
    }

    /**
     * Cover height in px, `away` steps from the centre. Largest in the middle,
     * shrinking smoothly outwards.
     */
    function tileHeight(away: number) {
      const falloff = 1 / (1 + Math.pow(away * spread, curve));
      return activeH * (thumbMin + (1 - thumbMin) * falloff);
    }

    /** Vertical position in px of a cover `s` steps from the centre. */
    function offsetAt(s: number) {
      return climb(s) + clearPx * Math.sign(s) * shove(Math.abs(s));
    }

    /** Looks up the ladder; mirrored for negative `s`. */
    function climb(s: number) {
      const away = Math.abs(s);
      const rung = Math.min(ladder.length - 2, Math.floor(away / RUNG));
      const frac = away / RUNG - rung;
      const rise = ladder[rung] + (ladder[rung + 1] - ladder[rung]) * frac;
      return Math.sign(s) * rise;
    }

    /** Eases the caption gap in as a cover reaches the centre. */
    function shove(away: number) {
      const x = Math.min(1, away);
      return x * x * (3 - 2 * x);
    }

    function setMeta(source: HTMLElement) {
      out.counter.textContent = source.dataset.counter ?? '';
      out.title.textContent = source.dataset.title ?? '';
      out.year.textContent = source.dataset.year ?? '';
      out.role.textContent = source.dataset.role ?? '';
    }

    function mod(value: number, m: number) {
      return ((value % m) + m) % m;
    }

    // ------------------------------------------------------------- motion

    /** Index of the project `offset` is closest to (unwrapped). */
    function slot(offset: number) {
      return Math.round(offset / step);
    }

    /** Aim at project slot `n` and ease there. */
    function goTo(n: number) {
      target = n * step;
      wake();
    }

    function wake() {
      if (running) return;
      running = true;
      lastTime = performance.now();
      requestAnimationFrame(frame);
    }

    function frame(now: number) {
      // Frame-rate independent: the same feel at 60Hz and 120Hz.
      const dt = Math.min(64, now - lastTime);
      lastTime = now;

      if (!dragging) {
        const k = 1 - Math.pow(1 - lerp, dt / (1000 / 60));
        current += (target - current) * k;
        if (Math.abs(target - current) < 0.1) current = target;
      }

      render();

      if (!dragging && current === target) {
        running = false;
        recentre();
        return;
      }

      requestAnimationFrame(frame);
    }

    /**
     * At rest, pull the position back near zero by whole loops, so nothing
     * visibly changes and the numbers never grow huge.
     */
    function recentre() {
      if (Math.abs(current) < loop * 8) return;
      const shift = Math.trunc(current / loop) * loop;
      current -= shift;
      target -= shift;
    }

    /** Scroll the shortest way to bring cover `i` to the centre (click or tab). */
    function centre(i: number) {
      target += distance(i, target);
      wake();
    }

    // ------------------------------------------------------------- events

    const menuOpen = () => document.querySelector('[data-menu][data-open]') !== null;

    /*
      Wheel and trackpad: move the target, then snap to the nearest project
      once the wheel goes quiet. Not passive — nothing else may scroll.
    */
    let wheelTimer = 0;

    window.addEventListener(
      'wheel',
      (event) => {
        if (menuOpen()) return;
        event.preventDefault();

        // Lines and pages to px.
        const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? viewH() : 1;
        // Trackpads scroll sideways too; follow whichever axis moved more.
        const delta =
          Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;

        target += delta * unit;
        wake();

        clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => goTo(slot(target)), 140);
      },
      { passive: false },
    );

    /*
      Touch: the rail follows the finger 1:1, then on release glides to the
      project the flick was heading for. Any real swipe moves at least one.
    */
    const SWIPE = 30;
    const FLING_MS = 220;
    const MAX_FLING = 5;

    let dragged = false;
    let startY = 0;
    let startOffset = 0;
    let lastTouchY = 0;
    let lastTouchT = 0;
    let velocity = 0;

    list.addEventListener(
      'touchstart',
      (event) => {
        if (event.touches.length !== 1) return;
        clearTimeout(wheelTimer);

        const y = event.touches[0].clientY;
        dragging = true;
        dragged = false;
        startY = lastTouchY = y;
        lastTouchT = event.timeStamp;
        // Catch the rail where it is, even mid-glide.
        startOffset = target = current;
        velocity = 0;
        wake();
      },
      { passive: true },
    );

    list.addEventListener(
      'touchmove',
      (event) => {
        if (!dragging) return;
        event.preventDefault();

        const y = event.touches[0].clientY;
        if (Math.abs(y - startY) > 6) dragged = true;

        current = target = startOffset + (startY - y);

        // px per ms, smoothed so one jittery sample doesn't decide the flick.
        const dt = event.timeStamp - lastTouchT;
        if (dt > 0) velocity = velocity * 0.2 + ((lastTouchY - y) / dt) * 0.8;
        lastTouchY = y;
        lastTouchT = event.timeStamp;
      },
      { passive: false },
    );

    const release = (event: TouchEvent) => {
      if (!dragging) return;
      dragging = false;

      // Finger held still before letting go: no flick.
      if (event.timeStamp - lastTouchT > 80) velocity = 0;

      const from = slot(startOffset);
      let to = slot(current + velocity * FLING_MS);

      const moved = current - startOffset;
      if (to === from && Math.abs(moved) > SWIPE) to += Math.sign(moved);
      to = Math.max(from - MAX_FLING, Math.min(from + MAX_FLING, to));

      goTo(to);
    };

    list.addEventListener('touchend', release);
    list.addEventListener('touchcancel', release);

    // Keys the page would normally scroll with.
    window.addEventListener('keydown', (event) => {
      if (menuOpen() || event.altKey || event.ctrlKey || event.metaKey) return;

      let by = 0;
      if (event.key === 'ArrowDown' || event.key === 'PageDown') by = 1;
      else if (event.key === 'ArrowUp' || event.key === 'PageUp') by = -1;
      else if (event.key === ' ' && !(event.target as HTMLElement).closest('a, button'))
        by = event.shiftKey ? -1 : 1;
      if (!by) return;

      event.preventDefault();
      goTo(slot(target) + by);
    });

    // Re-measure on a real resize, keeping the same project centred.
    let lastW = window.innerWidth;
    let lastH = viewH();
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastW && viewH() === lastH) return;
      lastW = window.innerWidth;
      lastH = viewH();

      const centred = slot(target);
      measure();
      current = target = centred * step;
      render();
    });

    // Clicking an off-centre cover brings it to the centre; only the centred one
    // opens. A swipe that ends on a cover isn't a click.
    list.addEventListener('click', (event) => {
      if (dragged) {
        dragged = false;
        event.preventDefault();
        return;
      }

      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-rail-item]');
      if (!item) return;

      const i = items.indexOf(item);
      if (i === -1) return;

      if (Math.abs(distance(i, current)) < step / 2) return;

      event.preventDefault();
      centre(i);
    });

    // Tabbing through the links centres each one.
    list.addEventListener('focusin', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-rail-item]');
      if (!item) return;

      const i = items.indexOf(item);
      if (i !== -1) centre(i);
    });
  }
</script>

<style is:global>
  /*
    The homepage never scrolls: the page is exactly one screen and the rail
    moves itself. With nothing to scroll, in-app browsers (Instagram) and
    Safari never shrink their toolbars, so the screen never resizes mid-swipe.
  */
  html.rail-host,
  html.rail-host body {
    height: 100svh;
    min-height: 0;
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
  }
</style>
