---
import { Image } from 'astro:assets';
import type { Project } from '../lib/work';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const total = projects.length;

/** `03/41` in the mockup — always two digits so the counter never reflows. */
const pad = (n: number) => String(n).padStart(2, '0');

/*
  Two renderings of the same list live in this file.

  Without JS you get `.rail__list` as it is written below: a plain vertical
  column of linked covers with visible captions. It scrolls, it is crawlable,
  and every project is one tab stop.

  With JS the root picks up `.rail--live` and the same <li>s become a fixed
  layer of absolutely positioned tiles driven by scroll offset — the focus rail
  from the mockup. Nothing is re-rendered; only positioning changes.
*/
---

<section class="rail relative" data-rail aria-label="Selected work">
  <div class="rail__bg hidden bg-rail-bg fixed inset-0 z-0"></div>

  <ol class="rail__list grid list-none justify-items-center gap-20 p-0" data-rail-list>
    {
      projects.map((project, i) => {
        const { title, year, role, cover, coverAlt } = project.data;
        const discipline = role.join(' & ');

        return (
          <li
            class="rail__item "
            data-rail-item
            data-counter={`${pad(i + 1)}/${pad(total)}`}
            data-title={title}
            data-year={String(year)}
            data-role={discipline}
          >
            <a
              class="rail__link block w-[var(--rail-w)] text-rail-ink no-underline"
              href={`/work/${project.id}`}
            >
              {cover ? (
                <Image
                  class="rail__cover block size-full object-cover aspect-[var(--rail-rw)/var(--rail-rh)]"
                  src={cover}
                  alt={coverAlt ?? ''}
                  widths={[320, 640, 960, 1440]}
                  sizes="(max-width: 767px) 88vw, 58vh"
                  loading="eager"
                />
              ) : (
                <span class="rail__cover block size-full aspect-[var(--rail-rw)/var(--rail-rh)] bg-[repeating-linear-gradient(45deg,#d8d5d1,#d8d5d1_8px,#e4e1dd_8px,#e4e1dd_16px)]" aria-hidden="true" />
              )}

              <span class="rail__caption mt-3.5 grid gap-1.5 font-mono text-[10px] font-semibold tracking-widest uppercase md:text-xs">
                <span>{title}</span>
                <span class="text-rail-dim">
                  {discipline}
                  {discipline && ' — '}
                  {year}
                </span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>

  {/* Duplicates the caption of whichever project is centred, so it is hidden
      from assistive tech — the links themselves carry the real names. */}
  {/* Everything visual here is a utility, so restyling the rail's text is a
      markup edit — nothing in the style block below touches type, colour or
      spacing any more. The rail__meta class survives only as the hook that
      the live-state rule needs. */}
  <div
    class="rail__meta hidden flex-col items-center justify-center gap-4 font-mono text-[10px] font-semibold leading-relaxed tracking-widest text-rail-ink uppercase md:flex-row md:gap-10 md:text-xs"
    aria-hidden="true"
  >
    {/* Counter and title share one line on a phone and split onto two from md.
        Four stacked lines around a cover read as a list; two read as a caption. */}
    {/* Each line is its own mask with the text in a child: `setMeta` writes
        textContent, which would wipe a mask nested inside the <p>. The
        `data-rail-*` hooks therefore sit on the INNER span — the same split
        <Reveal> uses, done by hand because the content is written by JS. */}
    <div class="flex w-[88vw] max-w-[22rem] shrink-0 grow-0 items-baseline justify-center gap-2 md:w-auto md:flex-1 md:basis-0 md:flex-col md:items-end md:gap-0 md:text-right">
      <p class="rail__line m-0 font-black text-signal">
        <span class="rail__line-in" data-rail-counter></span>
      </p>
      {/* The title is the one line here that is a NAME rather than metadata,
          so it opts out of the panel's mono/uppercase treatment: normal case,
          normal face, tighter tracking. The counter, year and role keep the
          mono voice because they are data. */}
      <p class="rail__line m-0 font-sans text-base font-medium normal-case tracking-normal text-rail-ink md:text-lg">
        <span class="rail__line-in" data-rail-title></span>
      </p>
    </div>

    {/* Reserves exactly the active tile so both columns hug its edges at any
        width — a vertical spacer on mobile, a horizontal one from md. */}
    <div
      class="h-[calc(var(--rail-w)*var(--rail-rh)/var(--rail-rw))] w-auto shrink-0 grow-0 md:h-auto md:w-[var(--rail-w)]"
    ></div>

    {/* Same collapse on the far side: role and year sit on one line below the
        cover, and only separate into the mockup's two-line column at md. */}
    <div class="flex w-[88vw] max-w-[22rem] shrink-0 grow-0 flex-row-reverse items-baseline justify-center gap-2 md:w-auto md:flex-1 md:basis-0 md:flex-col md:items-start md:gap-0 md:text-left">
      <p class="rail__line m-0 text-rail-dim">
        <span class="rail__line-in" data-rail-year></span>
      </p>
      <p class="rail__line m-0 text-rail-ink">
        <span class="rail__line-in" data-rail-role></span>
      </p>
    </div>
  </div>

  <div class="rail__runway hidden" data-rail-runway></div>
</section>

{/* Runs before the deferred module below, so the static list never flashes. */}
<script is:inline>
  document.querySelector('[data-rail]').classList.add('rail--live');
  document.documentElement.classList.add('rail-host');
</script>

<style>
  @reference '../styles/global.css';

  /*
    What is left here is only what utilities genuinely cannot say: the
    `.rail--live` state flip (a class toggled at runtime that restyles
    descendants), and the responsive re-tuning of the engine variables.

    Everything visual — type, colour, spacing, the meta panel's layout, the
    cover's aspect ratio and placeholder — now lives in the markup as classes,
    so changing how the rail looks is an edit up there, not down here.
  */

  @media (max-width: 767px) {
    .rail {
      --rail-w: 88vw;
      --rail-spread: 1.55;
      --rail-clear: 64;

      /*
        A phone is tall and narrow, so the same curve that shows three tiles a
        side on a desktop was showing six or seven here — the swell read as a
        long list rather than one cover with a couple of neighbours.

        The lever is the FLOOR, not the falloff: raising thumb-min makes the
        far tiles bigger, so the running total reaches the bottom of the screen
        in fewer steps and the cull happens sooner. (Raising spread does the
        opposite — smaller tiles mean more of them fit before the edge.)

        0.28 lands on 2-3 a side from a 375x667 phone up to a 412x915 one.
      */
      --rail-thumb-min: 0.28;

      /* The neighbours sat about 3px apart, which read as a stack rather than
         separate covers. 0.07 opens that to ~13px without changing how many
         survive the cull. */
      --rail-gap: 0.07;
    }
  }

  /* The swell tracks the user's own scrolling rather than animating on its
     own, so it stays; only the scripted glide to a clicked cover comes off. */
  @media (prefers-reduced-motion: reduce) {
    .rail {
      --rail-glide: 0;
    }
  }

  /* ------------------------------------------------------------------ live */

  .rail--live .rail__bg,
  .rail--live .rail__runway {
    display: block;
  }

  .rail--live .rail__list {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 1;
  }

  /*
    Between the inline script adding .rail--live and the deferred module first
    running render(), every tile is absolutely positioned at 50%/50% with no
    transform yet — i.e. all of them stacked dead centre. That showed as one
    cover flashing in the middle before the rail scattered into place.

    So the list stays invisible until the engine has positioned the tiles
    once. .rail--placed is added at the end of the first render(). Visibility
    rather than opacity: it does not create a compositing layer, and it still
    lets the browser lay the tiles out underneath.
  */
  .rail--live .rail__list {
    visibility: hidden;
  }

  .rail--live.rail--placed .rail__list {
    visibility: visible;
  }

  /*
    Entry: the rail grows into place.

    It starts small and settles at its resting size, so the covers scale up
    into the layout rather than sliding in from anywhere.

    Deliberately on the LIST, not on the tiles. `render()` owns `transform`
    on every `.rail__item` and the `scale()` on every `.rail__link`, and
    rewrites both every frame, so anything written alongside those is gone by
    the next scroll frame. The list is the one layer in the rail that no JS
    touches: scaling it composites the whole tile layer as a single object,
    and render goes on working in its own coordinate space entirely unaware.
    No per-frame JS and no ladder to rebuild.

    Opacity rides along because the small state has to be SEEN for the growth
    to read — the rail is `visibility: hidden` until `.rail--placed` lands, so
    without a fade the covers would simply appear part-grown.

    The delay holds until the frame's own sweep has finished: RevealIntro
    staggers ~0.055s per line over a 0.9s slide, so the last of the frame's
    ten lines lands around 1.4s. Two beats — the chrome arrives, then the work.
  */
  .rail--live .rail__list {
    transform: scale(var(--rail-zoom, 0.82));
    transform-origin: 50% 1%;
    opacity: 0;
  }

  .rail--live.rail--placed .rail__list {
    transform: scale(1);
    opacity: 1;
    /* Eased almost entirely out, so the last third is a slow settle rather
       than a box finishing a resize. The fade is shorter and unguided — it
       only has to get out of the way of the growth. */
    transition:
      transform 1100ms cubic-bezier(0.16, 1, 0.3, 1) 400ms,
      opacity 700ms ease-out 400ms;
  }

  /* An unrequested scale on load is exactly the kind of motion this query
     exists to suppress; the swell still tracks the user's own scrolling. */
  @media (prefers-reduced-motion: reduce) {
    .rail--live .rail__list {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }

  .rail--live .rail__item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--rail-w);
    aspect-ratio: var(--rail-rw) / var(--rail-rh);
    /* The box stays full size and the link scales inside it, so a shrunken
       cover's hit area shrinks with it rather than staying full-bleed. */
    pointer-events: none;
    will-change: transform, filter, opacity;
  }

  .rail--live .rail__link {
    width: 100%;
    height: 100%;
    pointer-events: auto;
    transform-origin: 50% 50%;
  }

  /* Still announced, still a real link — just no longer drawn. */
  .rail--live .rail__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Fixed and above the tile layer, so the caption of whichever cover is
     centred reads over the rail rather than scrolling away beneath it. */
  .rail--live .rail__meta {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* ------------------------------------------------------- meta entry */

  /*
    The four info lines slide out from behind a hard edge, the same gesture
    the frame's own <Reveal> lines use — the mask is the <p> and the text
    inside it is the transformable layer.

    Done here rather than with <Reveal> because `setMeta` writes textContent
    on every project change: a mask nested inside the <p> would be wiped by
    the first scroll. Hence the mask IS the <p>, and the `data-rail-*` hook
    sits on the inner span where setMeta can safely overwrite it.

    Each column travels away from the cover it belongs to — the left column
    enters from the left, the right from the right — so the pair reads as one
    pass opening outwards around the centre rather than as four lines
    arriving from the same place.

    This is a one-shot on load, keyed to `.rail--placed`, NOT to setMeta:
    the lines are written again on every project change and re-animating them
    each time would turn a caption into a slot machine.
  */
  .rail--live .rail__line {
    overflow: hidden;
    /* Clipping only along the travel axis; the block axis stays visible so
       descenders are never shaved. */
    padding-block: 0.15em;
    margin-block: -0.15em;
  }

  .rail--live .rail__line-in {
    display: inline-block;
    transform: translateX(var(--rail-meta-from, -110%));
    opacity: 0;
    will-change: transform;
  }

  /* Mirrored so the far column opens the other way. */
  .rail--live .rail__meta > :last-child .rail__line-in {
    --rail-meta-from: 110%;
  }

  .rail--live.rail--placed .rail__line-in {
    transform: translateX(0);
    opacity: 1;
    /* Lands with the rail rather than after it, so the covers and their
       caption arrive as one beat. The second line of each column trails the
       first by a touch — the same stagger the frame sweeps with. */
    transition:
      transform 900ms cubic-bezier(0.16, 1.11, 0.3, 1) var(--rail-meta-delay, 500ms),
      opacity 500ms ease-out var(--rail-meta-delay, 500ms);
  }

  .rail--live .rail__meta .rail__line:nth-child(2) .rail__line-in {
    --rail-meta-delay: 580ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .rail--live .rail__line-in {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }

</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-rail]');
  if (root) initRail(root);

  function initRail(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>('[data-rail-list]')!;
    const runway = root.querySelector<HTMLElement>('[data-rail-runway]')!;

    const originals = Array.from(list.querySelectorAll<HTMLElement>('[data-rail-item]'));
    const count = originals.length;
    if (count === 0) return;

    const out = {
      counter: root.querySelector<HTMLElement>('[data-rail-counter]')!,
      title: root.querySelector<HTMLElement>('[data-rail-title]')!,
      year: root.querySelector<HTMLElement>('[data-rail-year]')!,
      role: root.querySelector<HTMLElement>('[data-rail-role]')!,
    };

    /*
      The loop is a modulo, not a clone-and-reset: every tile's position is
      `distance from centre` wrapped into a span of `items × step`, so the
      column repeats forever while scrolling stays entirely native.

      The runway it scrolls through is finite — browsers render a document
      this tall far more happily than a millionaire-pixel one — and the rail
      walks back towards the middle of it while at rest. See `recentre`.
    */
    const RUNWAY = 100_000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let items: HTMLElement[] = [];
    let anchor = 0;
    let step = 1;
    let loop = 1;
    let activeH = 0;
    let gapPx = 0;
    let clearPx = 0;
    let spread = 0.9;
    let curve = 2.2;
    let thumbMin = 0.16;
    let fadeStep = 0.12;
    let fadeMin = 0.4;
    let cullAt = 0;
    let halfView = 0;
    let active = -1;

    /*
      Every tile is a different size now, so the distance between two of them
      depends on both — there is no single pitch to multiply by. `ladder` is
      the running total of (tile height + gap) sampled every RUNG slots: look
      a slot distance up in it and you get the pixel offset that leaves
      exactly one gap between every tile along the way. `reachSlots` is where
      that total runs off the bottom of the screen.
    */
    // Fine enough that the trapezoids below still track a steep swell. At 0.05
    // the sampled height changed too much between rungs, the integral came out
    // short, and covers overlapped by a dozen px mid-scroll.
    const RUNG = 0.005;
    let ladder: number[] = [0];
    let reachSlots = 0;

    // Frame loop: awake while anything is moving, asleep otherwise, so an
    // untouched page is not recalculating styles sixty times a second.
    let running = false;
    let idleFrames = 0;
    // True while a settle-glide is in flight, so coming to rest at the end of
    // it does not start another one.
    let snapping = false;
    let lastY = NaN;

    let glideMs = 700;

    runway.style.height = `${RUNWAY}px`;
    history.scrollRestoration = 'manual';

    measure();
    jump(anchor);
    render();

    // Every tile now carries a real transform, so the list can be shown. Until
    // this point they were all stacked at 50%/50% and revealing them would
    // flash a single centred cover.
    root.classList.add('rail--placed');

    /**
     * Entry animation: the covers fade up while the counter races through the
     * project numbers and lands on the first one.
     *
     * It reads as the rail finding its position rather than as something
     * sliding in, which is the same voice as the rest of the site — a counter
     * spinning up is a machine reporting state, not decoration.
     *
     * The counter is driven off a clock rather than a per-frame increment so
     * the spin lasts the same time whatever the refresh rate, and it always
     * lands on the real value `setMeta` would have written anyway.
     */
    /**
     * Rebuilds the spacing table from the CURRENT swell values.
     *
     * Climb until the running total leaves the screen; past that a tile cannot
     * be seen however large the rail gets.
     *
     * The integrand is the height at the MIDPOINT between consecutive slots,
     * not at the slot itself. Two tiles one slot apart need half of each
     * between their centres, and over a whole slot that averages to the height
     * mid-way — sampling at the slot instead over-counts the big centre tile
     * and under-counts its smaller neighbour, which is what let covers overlap
     * once the swell got steep.
     *
     * Split out of `measure()` so it can be rebuilt whenever the swell values
     * change.
     */
    function buildLadder() {
      ladder = [0];
      let rise = 0;
      let slot = 0;
      while (rise < cullAt && ladder.length < 20000) {
        rise += (tileHeight(slot + RUNG / 2) + gapPx) * RUNG;
        slot += RUNG;
        ladder.push(rise);
      }
      reachSlots = slot;
    }

    /**
     * Derives every pixel in the rail from the tile's own laid-out size, so
     * the CSS custom properties stay the single source of truth.
     */
    function measure() {
      const style = getComputedStyle(root);
      const num = (name: string, fallback: number) => {
        const value = parseFloat(style.getPropertyValue(name));
        return Number.isFinite(value) ? value : fallback;
      };

      spread = num('--rail-spread', 0.9);
      curve = num('--rail-curve', 2.2);
      thumbMin = num('--rail-thumb-min', 0.16);
      fadeStep = num('--rail-fade', 0.12);
      fadeMin = num('--rail-fade-min', 0.4);
      glideMs = reduced.matches ? 0 : num('--rail-glide', 700);

      activeH = originals[0].offsetHeight;
      gapPx = activeH * num('--rail-gap', 0.03);
      clearPx = num('--rail-clear', 0);
      halfView = window.innerHeight / 2;
      cullAt = halfView + activeH;

      // Scroll distance per project is a feel decision, not a consequence of
      // how big the thumbnails happen to be — so it is measured against the
      // viewport, and the tile sizes below cannot change the gearing.
      step = Math.max(1, window.innerHeight * num('--rail-step', 0.34));

      /*
        Climb until the running total leaves the screen; past that a tile
        cannot be seen however large the rail gets.

        The integrand is the height at the MIDPOINT between consecutive slots,
        not at the slot itself. Two tiles one slot apart need half of each
        between their centres, and over a whole slot that averages to the
        height mid-way — sampling at the slot instead over-counts the big
        centre tile and under-counts its smaller neighbour, which is what let
        covers overlap once the swell got steep.
      */
      buildLadder();

      // Enough tiles to fill that reach both ways, so the wrap never exposes
      // an empty edge and no tile is asked to appear twice at once.
      const copies = Math.max(1, Math.ceil((Math.ceil(reachSlots) * 2 + 2) / count));
      if (items.length !== count * copies) clone(copies);

      loop = items.length * step;
      anchor = Math.round(RUNWAY / 2 / loop) * loop;
    }

    /** Repeats the authored tiles until the rail fills the viewport. */
    function clone(copies: number) {
      for (const el of list.querySelectorAll('[data-rail-clone]')) el.remove();

      for (let c = 1; c < copies; c++) {
        for (const original of originals) {
          const copy = original.cloneNode(true) as HTMLElement;
          copy.setAttribute('data-rail-clone', '');
          copy.setAttribute('aria-hidden', 'true');
          for (const link of copy.querySelectorAll('a')) link.tabIndex = -1;
          list.appendChild(copy);
        }
      }

      items = Array.from(list.querySelectorAll<HTMLElement>('[data-rail-item]'));
    }

    /** Signed scroll distance from the centre to tile `i`, wrapped into the loop. */
    function distance(i: number, offset: number) {
      const raw = i * step - offset;
      return (((raw + loop / 2) % loop) + loop) % loop - loop / 2;
    }

    function render() {
      const offset = window.scrollY - anchor;

      for (let i = 0; i < items.length; i++) {
        const el = items[i];
        const s = distance(i, offset) / step;
        const away = Math.abs(s);
        const y = offsetAt(s);
        const h = tileHeight(away);

        // Cull against the tile's own height rather than the active tile's,
        // or the small far ones stay alive well below the fold.
        if (Math.abs(y) - h / 2 > halfView) {
          if (el.style.visibility !== 'hidden') el.style.visibility = 'hidden';
          continue;
        }
        if (el.style.visibility) el.style.visibility = '';

        const opacity = Math.max(fadeMin, 1 - away * fadeStep);

        el.style.transform = `translate(-50%, -50%) translate3d(0, ${y.toFixed(2)}px, 0)`;
        el.style.opacity = opacity.toFixed(3);
        el.style.zIndex = String(1000 - Math.round(away * 10));

        const link = el.firstElementChild as HTMLElement;
        link.style.transform = `scale(${(h / activeH).toFixed(4)})`;
      }

      const next = mod(Math.round(offset / step), count);
      if (next !== active) {
        active = next;
        setMeta(originals[next]);
      }
    }

    /**
     * Height in px of a tile `away` slots from the centre.
     *
     * One smooth decay all the way out, with no special case for the first
     * neighbour: a tile grows continuously as it approaches the middle and
     * peaks only when it is exactly there. The previous curve deliberately
     * flattened past ±1 so the centre tile would stand alone, which is the
     * opposite of a gradual swell.
     */
    function tileHeight(away: number) {
      const falloff = 1 / (1 + Math.pow(away * spread, curve));
      return activeH * (thumbMin + (1 - thumbMin) * falloff);
    }

    /**
     * Screen offset in px for a tile `s` slots from the centre.
     *
     * The ladder is a running total from slot 0 outwards, so reading it as
     * `±rise` only spaces things correctly when a cover is sitting exactly at
     * the centre. Half way between two, both got pushed a full half-gap away
     * from the middle: a 105px hole opened up between them while the small
     * ones behind overlapped by 16px.
     *
     * Reading it as a continuous curve instead fixes that. `climb` is defined
     * for negative s too (odd, so it mirrors), and the offset of a tile is
     * simply its own climb — no reflection around the centre, so the spacing
     * between any two neighbours is the integral between them wherever the
     * rail happens to be resting.
     */
    function offsetAt(s: number) {
      return climb(s) + clearPx * Math.sign(s) * shove(Math.abs(s));
    }

    /** The ladder read as an odd function, so it is smooth through zero. */
    function climb(s: number) {
      const away = Math.abs(s);
      const rung = Math.min(ladder.length - 2, Math.floor(away / RUNG));
      const frac = away / RUNG - rung;
      const rise = ladder[rung] + (ladder[rung + 1] - ladder[rung]) * frac;
      return Math.sign(s) * rise;
    }

    /** Eases the meta clearance in, so it does not pop as a tile takes centre. */
    function shove(away: number) {
      const x = Math.min(1, away);
      return x * x * (3 - 2 * x);
    }

    /**
     * Eases out of whatever the scroll was already doing rather than out of
     * rest. A click can land while the page still carries speed; an ease-in-out
     * would brake it to a stop and start again, which reads as a stutter.
     */
    function ease(t: number) {
      return 1 - Math.pow(1 - t, 3);
    }

    function setMeta(source: HTMLElement) {
      out.counter.textContent = source.dataset.counter ?? '';
      out.title.textContent = source.dataset.title ?? '';
      out.year.textContent = source.dataset.year ?? '';
      out.role.textContent = source.dataset.role ?? '';
    }

    function mod(value: number, m: number) {
      return ((value % m) + m) % m;
    }

    // ------------------------------------------------------------- motion

    // Lenis (wired up globally in Frame.astro) owns the scroll, so
    // programmatic moves go through it rather than window.scrollTo. The rail
    // reads window.scrollY either way, and Lenis cancels its own scrollTo the
    // moment the user touches the wheel.

    /** Puts the page at `top` with no animation, keeping Lenis in sync. */
    function jump(top: number) {
      window.lenis?.scrollTo(top, { immediate: true, force: true });
    }

    /** Moves the page to `top` over `ms`, through Lenis. */
    function glide(top: number, ms: number) {
      if (ms <= 0) jump(top);
      else window.lenis?.scrollTo(top, { duration: ms / 1000, easing: ease });

      wake();
    }

    /**
     * The runway has ends, so walk back towards its middle once the rail has
     * come to rest. Shifting by a whole number of loop lengths is invisible —
     * every tile lands on precisely the pixel it already occupied — and doing
     * it at rest means no momentum is ever cut short.
     */
    function recentre() {
      const drift = window.scrollY - anchor;
      if (Math.abs(drift) < loop * 8) return;
      jump(window.scrollY - Math.trunc(drift / loop) * loop);
    }

    function wake() {
      if (running) return;
      running = true;
      idleFrames = 0;
      requestAnimationFrame(frame);
    }

    function frame() {
      render();

      const y = window.scrollY;
      idleFrames = y === lastY ? idleFrames + 1 : 0;
      lastY = y;

      // A dozen still frames is comfortably past the end of any momentum.
      if (idleFrames > 12) {
        running = false;

        // Settling the rail on a whole project is what makes it read as a
        // rail rather than a free scroll — it leaves the layout back in the
        // state it started in, with one cover square in the middle.
        //
        // `snapping` guards the obvious trap: the glide below scrolls the
        // page, which wakes this loop, which comes to rest again and would
        // otherwise snap forever. It clears once the glide has landed.
        if (!snapping && snap()) return;

        snapping = false;
        recentre();
        return;
      }

      requestAnimationFrame(frame);
    }

    /**
     * Glides to whichever project is nearest the middle, if it is not already
     * there. Returns whether a move was started.
     *
     * The threshold is deliberately small: a rail resting a pixel or two off
     * centre is invisible, and snapping it would only cost a frame of motion
     * for no visible gain.
     */
    function snap() {
      const offset = window.scrollY - anchor;
      const nearest = Math.round(offset / step);
      const drift = nearest * step - offset;

      if (Math.abs(drift) < 1) return false;

      snapping = true;
      // Always a short hop — the furthest it can ever travel is half a slot,
      // so the easing curve a click uses would feel sluggish here.
      // glideMs is 0 under reduced-motion, and glide() turns that into a jump.
      glide(window.scrollY + drift, glideMs === 0 ? 0 : Math.min(glideMs, 420));
      return true;
    }

    /**
     * Scrolls the shortest way round the loop to put tile `i` in the middle.
     * Nothing calls this from scrolling any more — only a click or a tab lands
     * a cover dead centre, and the rail is otherwise free.
     */
    function centre(i: number) {
      const drift = distance(i, window.scrollY - anchor);
      if (drift === 0) return;

      // Longer trips take longer, but not linearly — three slots away should
      // not feel three times as far.
      const slots = Math.abs(drift) / step;
      glide(window.scrollY + drift, glideMs * Math.min(2, 0.7 + Math.sqrt(slots) * 0.5));
    }

    // ------------------------------------------------------------- events

    window.addEventListener('scroll', wake, { passive: true });

    // Touching the page mid-settle hands control straight back: Lenis cancels
    // its own scrollTo on wheel/touch, and clearing the guard means the rail
    // will settle again once this new gesture runs out.
    for (const type of ['wheel', 'touchstart', 'keydown'] as const) {
      window.addEventListener(type, () => { snapping = false; }, { passive: true });
    }

    window.addEventListener('resize', () => {
      const centred = Math.round((window.scrollY - anchor) / step);
      measure();
      jump(anchor + centred * step);
      render();
    });

    // Clicking a small off-centre cover means "bring that one up", not "open
    // it" — only the cover at full size navigates.
    list.addEventListener('click', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-rail-item]');
      if (!item) return;

      const i = items.indexOf(item);
      if (i === -1) return;

      if (Math.abs(distance(i, window.scrollY - anchor)) < step / 2) return;

      event.preventDefault();
      centre(i);
    });

    // Tabbing through the authored links pulls each one to the middle.
    list.addEventListener('focusin', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-rail-item]');
      if (!item) return;

      const i = items.indexOf(item);
      if (i !== -1) centre(i);
    });
  }
</script>

<style is:global>
  /* The runway is a scroll surface, not something to look at. */
  html.rail-host {
    scrollbar-width: none;
  }

  html.rail-host::-webkit-scrollbar {
    display: none;
  }
</style>
